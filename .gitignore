# Local backup snapshots created by tooling — never commit
.claude-revert-backup-*/
.sixth/

# Code-signing artifacts — Azure Trusted Signing dlib + extracted .nupkg.
# Downloaded by scripts/install-signing-dlib.ps1 on the build machine.
# Never commit binaries.
.signing/

# ── Auto-Type runtime debug artifacts — NEVER commit ──
# Generated during Auto-Type runs. `.autotype-screenshots/` holds raw screen
# captures of the candidate's editor (i.e. live interview content), and
# `.autotype-plans.jsonl` logs the editor text + code that was typed. Both
# can contain sensitive captured screen content — keep them off git entirely.
.autotype-screenshots/
.autotype-plans.jsonl
.autotype-test/
server/scripts/.autotype-test/

# Local dev CDP probes + design-iteration screenshots (not for commit)
/cdp-*.mjs
/current-*.png
/globe-*.png
