{
  "name": "interview-copilot-ai",
  "private": true,
  "version": "2.3.0",
  "description": "AI-powered real-time interview assistant",
  "author": {
    "name": "Interview Copilot",
    "email": "support@interviewcopilot.app"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "electron:start": "concurrently -k \"npm run dev\" \"wait-on tcp:3005 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:publish": "npm run build && electron-builder --publish=always"
  },
  "build": {
    "appId": "com.interviewcopilot.app",
    "productName": "Interview Copilot",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "madhavvan",
      "repo": "h2so4"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "artifactName": "InterviewCopilot-Mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Interview Copilot needs microphone access to capture interview audio.",
        "NSScreenCaptureUsageDescription": "Interview Copilot needs screen capture to provide real-time interview assistance."
      }
    },
    "win": {
      "target": "nsis",
      "artifactName": "InterviewCopilot-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "InterviewCopilot-Linux.${ext}",
      "category": "Utility"
    }
  },
  "dependencies": {
    "@google/genai": "^1.36.0",
    "@react-oauth/google": "^0.13.4",
    "better-sqlite3": "^12.8.0",
    "electron-updater": "^6.3.9",
    "groq-sdk": "0.9.1",
    "lucide-react": "^0.562.0",
    "openai": "4.24.1",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/node": "^22.14.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.4"
  }
}
