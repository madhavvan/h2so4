{
  "name": "interview-copilot-ai",
  "private": true,
  "version": "4.0.12",
  "description": "AI-powered real-time interview assistant",
  "author": {
    "name": "Interview Copilot",
    "email": "support@interviewcopilot.app"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "postinstall": "patch-package && electron-rebuild -f",
    "icons": "node scripts/build-icons.mjs",
    "electron:start": "concurrently -k \"npm run dev\" \"wait-on tcp:3005 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:publish": "npm run build && electron-builder --publish=always"
  },
  "build": {
    "appId": "com.interviewcopilot.app",
    "productName": "Interview Copilot",
    "directories": {
      "output": "dist-electron"
    },
    "afterPack": "./scripts/notary-cleanup.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "madhavvan",
        "repo": "interviewcopilot-releases",
        "releaseType": "draft"
      },
      {
        "provider": "github",
        "owner": "madhavvan",
        "repo": "h2so4",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "InterviewCopilot-Mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Interview Copilot needs microphone access to capture interview audio.",
        "NSScreenCaptureUsageDescription": "Interview Copilot needs screen capture to provide real-time interview assistance."
      },
      "notarize": true,
      "files": [
        "!**/node_modules/@nut-tree-fork/libnut-linux/**/*",
        "!**/node_modules/@nut-tree-fork/libnut-win32/**/*"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "InterviewCopilot-Setup.${ext}",
      "verifyUpdateCodeSignature": false,
      "azureSignOptions": {
        "endpoint": "https://eus.codesigning.azure.net/",
        "codeSigningAccountName": "minica-signing-4729",
        "certificateProfileName": "minicaai-prod",
        "publisherName": "Venu Madhav Pentala"
      },
      "files": [
        "!**/node_modules/@nut-tree-fork/libnut-darwin/**/*",
        "!**/node_modules/@nut-tree-fork/libnut-linux/**/*"
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "differentialPackage": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "artifactName": "InterviewCopilot-Linux.${ext}",
      "category": "Utility",
      "files": [
        "!**/node_modules/@nut-tree-fork/libnut-darwin/**/*",
        "!**/node_modules/@nut-tree-fork/libnut-win32/**/*"
      ]
    }
  },
  "dependencies": {
    "@google/genai": "^1.48.0",
    "@lobehub/icons-static-svg": "^1.90.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@phosphor-icons/react": "^2.1.10",
    "@react-oauth/google": "^0.13.4",
    "better-sqlite3": "^12.8.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.3.9",
    "groq-sdk": "^1.1.2",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.12.0",
    "openai": "^6.34.0",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.14.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "patch-package": "^8.0.1",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.10",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-svgr": "^5.2.0",
    "wait-on": "^9.0.4"
  }
}
