{
  "name": "interview-copilot-ai",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "electron:start": "concurrently -k \"npm run dev\" \"wait-on tcp:3005 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.interviewcopilot.app",
    "productName": "Interview Copilot",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "InterviewCopilot-Mac.${ext}"
    },
    "win": {
      "target": "nsis",
      "artifactName": "InterviewCopilot-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "InterviewCopilot-Linux.${ext}"
    }
  },
  "dependencies": {
    "@google/genai": "^1.36.0",
    "@react-oauth/google": "^0.13.4",
    "better-sqlite3": "^12.8.0",
    "groq-sdk": "0.9.1",
    "lucide-react": "^0.562.0",
    "openai": "4.24.1",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/node": "^22.14.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.4"
  }
}
