# Stripe (USA + Global — settles to US bank)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_USD=price_xxx   # $50/mo USD

# Razorpay (India — settles to Indian bank)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_PLAN_ID=plan_xxx   # Rs.3999/mo INR plan

# JWT
JWT_SECRET=your-secret-key-change-this-in-production

# Google OAuth — client ID alone is enough for the web GSI flow.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Client Secret — REQUIRED for Electron desktop Google Sign-In (server-side redirect flow).
# Get it from Google Cloud Console → APIs & Services → Credentials → your OAuth 2.0 Client ID.
GOOGLE_CLIENT_SECRET=

# Public HTTPS URL of this server — REQUIRED on Railway so the Google OAuth callback URI
# is built as https://..., not http:// (Express req.protocol returns the wrong scheme
# behind Railway's reverse proxy even with trust proxy, belt-and-suspenders).
# Example: SERVER_URL=https://h2so4-production.up.railway.app
SERVER_URL=

# Admin (comma-separated emails — never commit real values)
ADMIN_EMAILS=you@example.com,admin@example.com

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Email — Resend (HTTPS) is the primary transport. REQUIRED in production.
# Railway / Render / Fly / most cloud hosts block outbound SMTP (ports 587/465)
# to Gmail & Office365, which makes nodemailer time out. Resend uses HTTPS
# (port 443) so the TCP path always works. Get a key at https://resend.com
# (free tier = 3,000 emails/month, 100/day — plenty for password resets).
#
# EMAIL_FROM must be a verified sender on a domain you've added to Resend.
# During development you can use their sandbox sender: onboarding@resend.dev
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# SMTP — fallback used only when RESEND_API_KEY is not set. Fine for local
# dev against Mailhog or a personal Gmail; do NOT rely on it in production
# because cloud hosts throttle or block outbound SMTP.
# Gmail example (create an App Password at myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM="minicaai <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Database — MUST point to a persistent path in production.
# On Railway, attach a Volume (e.g. mounted at /data) and set:
#   DATABASE_PATH=/data/minicaai.db
# Without this, SQLite writes to the container's ephemeral filesystem
# and ALL users/licenses/conversations are wiped on every restart.
DATABASE_PATH=
