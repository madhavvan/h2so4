# Stripe (USA + Global — settles to US bank)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Per-tier price IDs. Run `node server/scripts/stripe-setup.mjs` once to
# create the products/prices in Stripe and print these IDs.
#   Basic: $25 one-time (3 credits · 14-day expiry)
#   Pro:   $29/month recurring (unlimited sessions)
#   Max:   $69/month recurring (unlimited + Auto-Type)
# The Basic renewal top-up ($6.99 for +1 credit) is priced inline by the
# server — no price ID needed for it.
STRIPE_PRICE_BASIC_USD=price_xxx
STRIPE_PRICE_PRO_USD=price_xxx
STRIPE_PRICE_MAX_USD=price_xxx

# Legacy Pro price — kept as a fallback so older deployments that still
# point at the $50/mo SKU keep working until they migrate. Safe to leave
# unset on new deployments once STRIPE_PRICE_PRO_USD is configured.
STRIPE_PRICE_USD=

# Razorpay (India — settles to Indian bank)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Per-tier Razorpay plan IDs. Create these in the Razorpay dashboard
# (Subscriptions → Plans) with the amounts below, then paste the plan IDs.
#   Pro:   ₹2499/month recurring
#   Max:   ₹5999/month recurring
# Basic (₹1999 one-time) and the Basic renewal (₹599) are one-time orders
# priced inline by the server — no plan ID needed for them.
RAZORPAY_PLAN_ID_PRO=plan_xxx
RAZORPAY_PLAN_ID_MAX=plan_xxx

# Legacy Pro plan — fallback alias, same story as STRIPE_PRICE_USD.
RAZORPAY_PLAN_ID=

# JWT
JWT_SECRET=your-secret-key-change-this-in-production

# Google OAuth — client ID alone is enough for the web GSI flow.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Client Secret — REQUIRED for Electron desktop Google Sign-In (server-side redirect flow).
# Get it from Google Cloud Console → APIs & Services → Credentials → your OAuth 2.0 Client ID.
GOOGLE_CLIENT_SECRET=

# Public HTTPS URL of this server — REQUIRED on Railway so the Google OAuth callback URI
# is built as https://..., not http:// (Express req.protocol returns the wrong scheme
# behind Railway's reverse proxy even with trust proxy, belt-and-suspenders).
# Example: SERVER_URL=https://api.minicaai.com
SERVER_URL=

# Admin (comma-separated emails — never commit real values)
ADMIN_EMAILS=you@example.com,admin@example.com

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Email — Resend (HTTPS) is the primary transport. REQUIRED in production.
# Railway / Render / Fly / most cloud hosts block outbound SMTP (ports 587/465)
# to Gmail & Office365, which makes nodemailer time out. Resend uses HTTPS
# (port 443) so the TCP path always works. Get a key at https://resend.com
# (free tier = 3,000 emails/month, 100/day — plenty for password resets).
#
# EMAIL_FROM must be a verified sender on a domain you've added to Resend.
# During development you can use their sandbox sender: onboarding@resend.dev
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# SMTP — fallback used only when RESEND_API_KEY is not set. Fine for local
# dev against Mailhog or a personal Gmail; do NOT rely on it in production
# because cloud hosts throttle or block outbound SMTP.
# Gmail example (create an App Password at myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM="minicaai <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Anthropic — Claude Sonnet 4.6 with hosted web_search tool. Available to
# basic/pro/max tiers (gated client-side; not exposed to free). The web_search
# tool is server-managed by Anthropic — no separate Brave/SerpAPI key needed.
ANTHROPIC_API_KEY=

# Database — MUST point to a persistent path in production.
# On Railway, attach a Volume (e.g. mounted at /data) and set:
#   DATABASE_PATH=/data/minicaai.db
# Without this, SQLite writes to the container's ephemeral filesystem
# and ALL users/licenses/conversations are wiped on every restart.
DATABASE_PATH=

# ── Support bot (Hari) ─────────────────────────────────────────────
# The public-facing chat assistant on minicaai.com. Calls OpenAI's
# Responses API with the native web_search tool. OpenAI key reuses
# the one already configured for the AI proxy — no separate key needed.
#
# OPENAI_API_KEY is already set in your env for the AI proxy. The
# support bot reads the same one.
#
# Override the model if OpenAI deprecates the default snapshot. Must be
# a Responses-API-compatible model with web_search tool support.
SUPPORT_MODEL=gpt-5.4-nano-2026-03-17

# DeepSeek — user-role (Basic+) support bot model. The ADMIN role always
# runs on Claude (SUPPORT_ANTHROPIC_MODEL / claude-sonnet-5) for eng-docs +
# destructive-tool step-up. The USER role runs DeepSeek V4 Flash when
# DEEPSEEK_API_KEY is set (fast + cheap), and falls back to Claude if it's
# blank — so user chat never goes dark. Get a key at platform.deepseek.com.
# Old deepseek-chat/deepseek-reasoner aliases deprecate 2026-07-24; pin V4.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Where "Talk to a human" handoffs go.
#
# SLACK: paste the Incoming Webhook URL from your Slack workspace
# (Apps → Incoming Webhooks → Add to a channel). When unset, Slack
# delivery is skipped silently — email-only mode.
SUPPORT_SLACK_WEBHOOK_URL=
# EMAIL: where to send the ticket email (Resend). Defaults to
# support@minicaai.com. Reply-To is set to the user's email so hitting
# Reply in your client routes back to them automatically.
SUPPORT_HANDOFF_EMAIL=support@minicaai.com

# ── Engineering docs encryption ──────────────────────────────────
# 32-byte base64 key. Used at server boot to decrypt docs/private/*.md.enc
# into memory; the decrypted content is fed to the support bot ONLY when
# the requester is an admin (ADMIN_EMAILS match), and surfaced via the
# admin-only /api/v1/support/admin-docs endpoint.
#
# Generate one with:  npm run docs:keygen  (in server/)
# Without this key, engineering docs are inaccessible — the public bot
# still works, but admin features 503. NEVER commit this value to git.
ENGINEERING_DOCS_KEY=

# ── Off-site database backups (S3 / R2 / B2) ─────────────────────────
# backup.js takes a daily VACUUM INTO snapshot, but by default it lands on
# the SAME Railway volume as the live DB — a volume delete/detach/corruption
# loses the backups together with the data. Set these to also upload each
# snapshot to an S3-compatible bucket (backupOffsite.js — dependency-free
# SigV4, nothing added to package.json). After deploying with these set:
#   1. Watch the boot log for "off-site self-test PASSED".
#   2. Do ONE manual restore drill: download a snapshot, open it locally,
#      verify row counts — before trusting it in a disaster.
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# 'auto' is correct for Cloudflare R2; set a real region for AWS S3.
BACKUP_S3_REGION=auto
# R2/B2 endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
# Leave empty for AWS S3 (virtual-hosted URL derived from bucket+region).
BACKUP_S3_ENDPOINT=
# Key prefix inside the bucket.
BACKUP_S3_PREFIX=minicaai-db-backups
# Optional but recommended: 64 hex chars (32 bytes). Snapshots are then
# AES-256-GCM encrypted client-side, so the bucket holder never sees
# plaintext user PII. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store this key somewhere OTHER than the bucket — lose it and every
# encrypted backup is unreadable.
BACKUP_ENCRYPTION_KEY=

# ── Session token TTL ────────────────────────────────────────────────
# JWT lifetime (jsonwebtoken expiresIn format). Default '14d'. Active
# clients rotate their token via /license/validate long before expiry;
# only devices offline longer than this must sign in again.
JWT_TTL=14d
