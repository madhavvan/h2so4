# Stripe (USA + Global — settles to US bank)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Per-tier price IDs — OPTIONAL under the 2026-07 pricing model. When unset,
# the server creates inline `price_data` at checkout time with the canonical
# amounts below, so a fresh deploy works with no Stripe Dashboard setup.
# Set these only if you prefer Dashboard-managed Prices; they are validated
# against the in-app amounts before every checkout (mismatch → loud warning
# + fallback to the inline price, never a wrong charge).
#   Basic: $30 one-time  · one 30-min interview
#   Pro:   $50 one-time  · one 1-hour interview
#   Max:   $89 one-time  · three 1-hour interviews
#   Ultra: $159/month    · 9 hours of interview time per cycle + Auto-Type
#   Enterprise: $1199/month · unlimited, never expires (the Team plan)
# Extension packs (+30 min $25 / +1 h $45 / +3 h $80) are priced inline by
# the server — no price IDs needed for them.
STRIPE_PRICE_BASIC_USD=price_xxx
STRIPE_PRICE_PRO_USD=price_xxx
STRIPE_PRICE_MAX_USD=price_xxx

# Legacy Pro price — kept as a fallback so older deployments that still
# point at the old recurring SKU keep working until they migrate. Safe to
# leave unset on new deployments once STRIPE_PRICE_PRO_USD is configured.
STRIPE_PRICE_USD=

# Razorpay (India — settles to Indian bank)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# ── Razorpay routing kill-switch (2026-07-16) ──
# While the Razorpay merchant account is PENDING approval, ALL new charges
# (India included) route to Stripe in USD. Set to true — together with
# INR_CHECKOUT_ENABLED=true in services/pricingService.ts on the client —
# once the account clears, and India routes back to Razorpay INR.
RAZORPAY_ROUTING_ENABLED=false

# Per-tier Razorpay plan IDs (recurring subscriptions only). 2026-07 model:
# ULTRA and ENTERPRISE are the recurring tiers — create monthly plans in the
# Razorpay dashboard (Subscriptions → Plans) and paste their IDs. Without
# them, India checkouts for that tier refuse (never sold as a one-time order,
# because a single charge that never recurs would hand out an open-ended
# subscription for one month of money).
#   Ultra:      ₹12,999/month recurring
#   Enterprise: ₹99,999/month recurring
RAZORPAY_PLAN_ID_ULTRA=plan_xxx
RAZORPAY_PLAN_ID_ENTERPRISE=plan_xxx

# Legacy Pro/Max plans — recognized so historical subscriptions keep
# resolving to the right tier in webhooks; NOT used for new checkouts
# (Basic ₹2,499 / Pro ₹4,199 / Max ₹7,399 are one-time orders priced
# inline, like the extension packs ₹2,099 / ₹3,799 / ₹6,799).
RAZORPAY_PLAN_ID_PRO=plan_xxx
RAZORPAY_PLAN_ID_MAX=plan_xxx

# Legacy Pro plan — fallback alias, same story as STRIPE_PRICE_USD.
RAZORPAY_PLAN_ID=

# JWT
JWT_SECRET=your-secret-key-change-this-in-production

# Google OAuth — client ID alone is enough for the web GSI flow.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Client Secret — REQUIRED for Electron desktop Google Sign-In (server-side redirect flow).
# Get it from Google Cloud Console → APIs & Services → Credentials → your OAuth 2.0 Client ID.
GOOGLE_CLIENT_SECRET=

# Public HTTPS URL of this server — REQUIRED on Railway so the Google OAuth callback URI
# is built as https://..., not http:// (Express req.protocol returns the wrong scheme
# behind Railway's reverse proxy even with trust proxy, belt-and-suspenders).
# Example: SERVER_URL=https://api.minicaai.com
SERVER_URL=

# Admin (comma-separated emails — never commit real values)
ADMIN_EMAILS=you@example.com,admin@example.com

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Email — Resend (HTTPS) is the primary transport. REQUIRED in production.
# Railway / Render / Fly / most cloud hosts block outbound SMTP (ports 587/465)
# to Gmail & Office365, which makes nodemailer time out. Resend uses HTTPS
# (port 443) so the TCP path always works. Get a key at https://resend.com
# (free tier = 3,000 emails/month, 100/day — plenty for password resets).
#
# EMAIL_FROM must be a verified sender on a domain you've added to Resend.
# During development you can use their sandbox sender: onboarding@resend.dev
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# SMTP — fallback used only when RESEND_API_KEY is not set. Fine for local
# dev against Mailhog or a personal Gmail; do NOT rely on it in production
# because cloud hosts throttle or block outbound SMTP.
# Gmail example (create an App Password at myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM="minicaai <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Anthropic — Claude with the hosted web_search tool. Available to the
# Pro, Max, and Ultra tiers (server-enforced: CLAUDE_TIERS in routes/ai.js;
# Basic and Free never reach the Claude routes). The web_search tool is
# server-managed by Anthropic — no separate Brave/SerpAPI key needed.
ANTHROPIC_API_KEY=

# Database — MUST point to a persistent path in production.
# On Railway, attach a Volume (e.g. mounted at /data) and set:
#   DATABASE_PATH=/data/minicaai.db
# Without this, SQLite writes to the container's ephemeral filesystem
# and ALL users/licenses/conversations are wiped on every restart.
DATABASE_PATH=

# ── Support bot (Hari) ─────────────────────────────────────────────
# The public-facing chat assistant on minicaai.com. Calls OpenAI's
# Responses API with the native web_search tool. OpenAI key reuses
# the one already configured for the AI proxy — no separate key needed.
#
# OPENAI_API_KEY is already set in your env for the AI proxy. The
# support bot reads the same one.
#
# Override the model if OpenAI deprecates the default snapshot. Must be
# a Responses-API-compatible model with web_search tool support.
SUPPORT_MODEL=gpt-5.4-nano-2026-03-17

# DeepSeek — user-role (Basic+) support bot model. The ADMIN role always
# runs on Claude (SUPPORT_ANTHROPIC_MODEL / claude-sonnet-5) for eng-docs +
# destructive-tool step-up. The USER role runs DeepSeek V4 Flash when
# DEEPSEEK_API_KEY is set (fast + cheap), and falls back to Claude if it's
# blank — so user chat never goes dark. Get a key at platform.deepseek.com.
# Old deepseek-chat/deepseek-reasoner aliases deprecate 2026-07-24; pin V4.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Where "Talk to a human" handoffs go.
#
# SLACK: paste the Incoming Webhook URL from your Slack workspace
# (Apps → Incoming Webhooks → Add to a channel). When unset, Slack
# delivery is skipped silently — email-only mode.
SUPPORT_SLACK_WEBHOOK_URL=
# EMAIL: where to send the ticket email (Resend). Defaults to
# support@minicaai.com. Reply-To is set to the user's email so hitting
# Reply in your client routes back to them automatically.
SUPPORT_HANDOFF_EMAIL=support@minicaai.com

# ── Engineering docs encryption ──────────────────────────────────
# 32-byte base64 key. Used at server boot to decrypt docs/private/*.md.enc
# into memory; the decrypted content is fed to the support bot ONLY when
# the requester is an admin (ADMIN_EMAILS match), and surfaced via the
# admin-only /api/v1/support/admin-docs endpoint.
#
# Generate one with:  npm run docs:keygen  (in server/)
# Without this key, engineering docs are inaccessible — the public bot
# still works, but admin features 503. NEVER commit this value to git.
ENGINEERING_DOCS_KEY=

# ── Off-site database backups (S3 / R2 / B2) ─────────────────────────
# backup.js takes a daily VACUUM INTO snapshot, but by default it lands on
# the SAME Railway volume as the live DB — a volume delete/detach/corruption
# loses the backups together with the data. Set these to also upload each
# snapshot to an S3-compatible bucket (backupOffsite.js — dependency-free
# SigV4, nothing added to package.json). After deploying with these set:
#   1. Watch the boot log for "off-site self-test PASSED".
#   2. Do ONE manual restore drill: download a snapshot, open it locally,
#      verify row counts — before trusting it in a disaster.
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# 'auto' is correct for Cloudflare R2; set a real region for AWS S3.
BACKUP_S3_REGION=auto
# R2/B2 endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
# Leave empty for AWS S3 (virtual-hosted URL derived from bucket+region).
BACKUP_S3_ENDPOINT=
# Key prefix inside the bucket.
BACKUP_S3_PREFIX=minicaai-db-backups
# Optional but recommended: 64 hex chars (32 bytes). Snapshots are then
# AES-256-GCM encrypted client-side, so the bucket holder never sees
# plaintext user PII. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store this key somewhere OTHER than the bucket — lose it and every
# encrypted backup is unreadable.
BACKUP_ENCRYPTION_KEY=

# ── Session token TTL ────────────────────────────────────────────────
# JWT lifetime (jsonwebtoken expiresIn format). Default '14d'. Active
# clients rotate their token via /license/validate long before expiry;
# only devices offline longer than this must sign in again.
JWT_TTL=14d

# ══════════════════════════════════════════════════════════════════════
#  EVERYTHING BELOW WAS MISSING FROM THIS FILE
#
#  The server reads all of it, and none of it was documented here. That
#  is how a fresh deploy comes up "working" and then loses whole
#  features one by one: no OPENAI_API_KEY means every GPT route 503s, no
#  DEEPGRAM_API_KEY means voice mode never transcribes, no
#  ENTITLEMENT_PRIVATE_KEY means Auto-Type falls back to an unsigned
#  probe. Each of those is silent until a user hits it.
#
#  Kept in sync by: server/test/env-example-coverage.test.js, which
#  fails if src/ reads a variable this file does not mention.
# ══════════════════════════════════════════════════════════════════════

# ── LLM providers ────────────────────────────────────────────────────
# The answer pipeline routes across all of these. A missing key does not
# stop boot — the individual model route fails at request time instead,
# which is why their absence is easy to miss until a customer reports it.
OPENAI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# ANTHROPIC_API_KEY is set further up (support bot + Auto-Type planners).

# ── Speech-to-text (voice mode) ──────────────────────────────────────
# Without DEEPGRAM_API_KEY the app cannot transcribe an interview at all.
DEEPGRAM_API_KEY=
# Needed only for strict mode below — the project the per-user temporary
# keys are minted under.
DEEPGRAM_PROJECT_ID=
# 'true' refuses to hand the master key to a client under any condition:
# every client gets a short-lived scoped key or nothing. Leave unset only
# while DEEPGRAM_PROJECT_ID is not configured yet.
DEEPGRAM_STRICT_NO_MASTER=

# ── Auto-Type entitlement signing (Ultra) ────────────────────────────
# Ed25519 private key (PEM) used to sign the entitlement claim the desktop
# app verifies against a public key baked into main.cjs. UNSET is safe:
# GET /api/v1/license/entitlements then returns 501 and the client falls
# back to the live probe. Set it to make Auto-Type work offline.
#   Generate: node -e "const {generateKeyPairSync}=require('crypto');const
#   {privateKey,publicKey}=generateKeyPairSync('ed25519');console.log(
#   privateKey.export({type:'pkcs8',format:'pem'}));console.log(
#   publicKey.export({type:'spki',format:'der'}).toString('base64'))"
# The printed base64 is what main.cjs AT_ENTITLEMENT_PUBLIC_KEY_B64 needs.
ENTITLEMENT_PRIVATE_KEY=

# ── Stripe per-tier Price ids ────────────────────────────────────────
# Optional. Unset means checkout uses inline price_data at the amounts in
# STRIPE_PRICE_DATA (routes/payments.js), which is correct out of the box.
# Set them to use real Stripe Price objects instead. STRIPE_PRICE_ULTRA_USD
# and STRIPE_PRICE_ENTERPRISE_USD additionally restore the prorated in-place
# upgrade path for the two subscription tiers — without them an Ultra or
# Enterprise upgrade falls through to a fresh checkout. (A subscription ITEM
# can only point at a real Price; Stripe rejects inline price_data there.)
# A stale value here charges a price that does not match what the app
# showed; assertStripePriceMatches refuses the charge rather than let that
# happen, so a mismatch surfaces as a 503, not a wrong bill.
STRIPE_PRICE_BASIC_USD=
STRIPE_PRICE_PRO_USD=
STRIPE_PRICE_MAX_USD=
STRIPE_PRICE_ULTRA_USD=
STRIPE_PRICE_ENTERPRISE_USD=

# ── Admin network guard ──────────────────────────────────────────────
# Comma-separated IPs/CIDRs allowed to reach admin surfaces. EMPTY MEANS
# NO NETWORK RESTRICTION — a leaked admin JWT is then replayable from
# anywhere. Set it in production.
ADMIN_IP_ALLOWLIST=

# ── Google sign-in handoff ───────────────────────────────────────────
# 'false' lets /google/poll release a session to a caller that presents no
# handoff code, falling back to a same-address check. Only for a fleet
# transition window — it re-opens the account-takeover path described in
# routes/auth.js (mintHandoffCode). Default (unset) is the secure 'true'.
GOOGLE_POLL_REQUIRE_CODE=

# ── Storage topology ─────────────────────────────────────────────────
# On Railway these are injected by the platform. RAILWAY_VOLUME_MOUNT_PATH
# is load-bearing: database.js refuses to start if DATABASE_PATH does not
# resolve underneath it on a hosted deploy, because writing SQLite to
# ephemeral container storage loses every account on the next restart.
RAILWAY_VOLUME_MOUNT_PATH=
# Local snapshot directory for the nightly backup job. Defaults to a path
# beside the database when unset.
BACKUP_PATH=

# ── Support bot models ───────────────────────────────────────────────
# Override the per-role defaults. SUPPORT_MODEL is set further up.
SUPPORT_ANTHROPIC_MODEL=
SUPPORT_AI_ASSIST_DRAFT_MODEL=
SUPPORT_AI_ASSIST_POLISH_MODEL=
# Self-hosted ntfy for support push. Defaults to the public ntfy.sh.
NTFY_SERVER_URL=
# DeepSeek-compatible base URL. Defaults to the public endpoint.
DEEPSEEK_BASE_URL=

# ── Support escalation over SMS (optional) ───────────────────────────
# All three are required together; the twilio dependency is lazily
# required in a try/catch, so leaving these unset simply disables SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Web search for the answer pipeline (optional) ────────────────────
BRAVE_API_KEY=

# ── Mobile / version surfaces ────────────────────────────────────────
# Where the phone-as-remote client is served from. MOBILE_APP_URLS takes a
# comma-separated list when more than one origin must be allowed.
MOBILE_APP_URL=
MOBILE_APP_URLS=
# Overrides the version /api/v1/app-version reports. Normally left unset —
# the release feed is the source of truth and FALLBACK_VERSION covers a
# fetch failure.
LATEST_APP_VERSION=

# ── Build identity (set BY the platform, not by you) ─────────────────
# /api/health reports `commit` so "which build is actually running?" can be
# answered with one request. It used to report only server/package.json's
# version — a string that has never changed and identifies nothing — so
# confirming a deploy meant reading a commit on GitHub, reading a deployment
# record, and trusting that they described the running process.
#
# Railway injects RAILWAY_GIT_COMMIT_SHA automatically; the others are the
# same convention on other platforms and are only fallbacks. Leave all of
# them blank here — setting one by hand would make /api/health report a
# commit that is not the one running, which is worse than 'unknown'.
RAILWAY_GIT_COMMIT_SHA=
SOURCE_VERSION=
GIT_COMMIT=
VERCEL_GIT_COMMIT_SHA=

# ── Local development only ───────────────────────────────────────────
# Forces the geo-detected country so region pricing/policy can be tested
# without a VPN. MUST be unset in production.
DEV_GEO_COUNTRY=
